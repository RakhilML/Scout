# Scout settings. Copy to .env (next to where you run scout) or to ~/.scout/.env.
# Environment variables override this file. Relative paths are relative to this file.

# --- Language model -----------------------------------------------------------------------
# Which backend answers: "openai" (any OpenAI-compatible server: LM Studio, Ollama, llama.cpp,
# vLLM), "exchange:DIR" (an agent or a person answers request files), "replay:DIR" (recorded
# answers only) or "record:DIR" (use the server and save every exchange for replay).
SCOUT_LLM=openai

# The server and model. `scout models` lists what the server offers.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b

# Only needed when LM Studio has "Require Authentication" on (Developer > Server Settings).
# Keep the server on localhost or a private network rather than exposing it to the internet.
LM_STUDIO_API_KEY=

# Seconds to wait for one model reply. Large models can need several minutes.
SCOUT_LLM_TIMEOUT=300

# Context window to plan for. Leave empty to use what the server reports (`scout check`).
SCOUT_CONTEXT_TOKENS=

# A smaller, faster model for planning searches (the main model still reads the pages).
SCOUT_PLANNER_MODEL=
# Seconds a model LM Studio loaded on demand stays loaded when idle: a daemon that runs every few
# hours then leaves the GPU free between runs. Empty: LM Studio's own setting.
SCOUT_MODEL_TTL=

# --- Search and pages ---------------------------------------------------------------------
# Search engine: "ddgs" (metasearch, nothing to set up) or "searxng:<URL>" for your own SearXNG
# instance (enable the json format in its settings.yml).
SCOUT_SEARCH=ddgs
# "playwright" reads pages that only show their text after JavaScript runs, in a headless
# browser (pip install -e ".[render]" and then: playwright install chromium). Empty: off.
SCOUT_RENDER=
# Pages to read per run.
SCOUT_MAX_RESULTS=6
# Most characters of one page that go to the model (the most relevant parts are chosen).
SCOUT_MAX_PAGE_CHARS=6000
# Search region as country-language, e.g. us-en, in-en, uk-en, de-de; wt-wt for none.
SCOUT_REGION=us-en
# Seconds to wait for a page, and extra attempts for transient failures.
SCOUT_REQUEST_TIMEOUT=12
SCOUT_FETCH_RETRIES=1
# Where copies of dead cited pages are looked up ("factcheck --cited --archive", and citation
# watches when a cited page dies): "wayback" (web.archive.org; only the dead page's address is
# sent) or "off".
SCOUT_ARCHIVE=wayback

# --- Storage ------------------------------------------------------------------------------
# Database, caches, watches (watches.yaml), feeds and logs live here.
SCOUT_DATA_DIR=~/.scout
# Reports go here (default: <SCOUT_DATA_DIR>/reports).
# SCOUT_OUTPUT_DIR=./reports
