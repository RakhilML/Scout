# ─── LM Studio Settings ───────────────────────────────────────────────────────
# Base URL of your LM Studio OpenAI-compatible server
LM_STUDIO_BASE_URL=http://YOUR_LM_STUDIO_HOST:1234/v1

# Model to use — run "scout models" to see all available models
# Options on your server:
#   openai/gpt-oss-120b   (best quality, slowest)
#   openai/gpt-oss-20b    (good quality, faster)
#   google/gemma-3-27b    (good quality)
#   google/gemma-3-12b    (fast)
LM_STUDIO_MODEL=openai/gpt-oss-20b

# API key — LM Studio doesn't require a real key, leave as-is
LM_STUDIO_API_KEY=lm-studio

# How long to wait for LLM response (seconds)
# Large models (120b) can take 3-5 minutes — set this high enough
SCOUT_LLM_TIMEOUT=300

# ─── Search Settings ──────────────────────────────────────────────────────────
# Number of DuckDuckGo results to fetch per run
SCOUT_MAX_RESULTS=6

# Max characters to extract per page (4000 ~ 1000 tokens)
# Increase for larger context models: 8000 for 32K+ context
SCOUT_MAX_PAGE_CHARS=4000

# HTTP timeout for fetching pages (seconds)
SCOUT_REQUEST_TIMEOUT=12

# How many times to retry a failed page fetch
SCOUT_FETCH_RETRIES=2

# ─── Output Settings ──────────────────────────────────────────────────────────
# Default folder for saving reports
SCOUT_OUTPUT_DIR=./reports

# ─── Scheduler Settings ───────────────────────────────────────────────────────
# Where to store the jobs database (SQLite)
SCOUT_DATA_DIR=~/.scout
